# Copy to .env and fill in real values. .env is gitignored.
# Load into a shell with:  set -a; source .env; set +a

# ── HuggingFace ────────────────────────────────────────────────────────────
# Token used by model init/download containers.
# Creates the `hf-token` Secret (key: `token`) in the `models` namespace.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NVIDIA NGC (for NIM containers: boltz-2, openfold-3, …) ────────────────
# API key for nvcr.io NIM models. Creates the `ngc-api-key` Secret (key:
# `NGC_API_KEY`) in `models`, referenced by NIM InferenceServices.
NGC_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NIM images are pulled from nvcr.io, which needs an image-pull secret — this is
# NOT an env var. Create it once per cluster (uses the NGC key above):
#   kubectl create secret docker-registry ngc-registry-secret -n models \
#     --docker-server=nvcr.io --docker-username='$oauthtoken' \
#     --docker-password="$NGC_API_KEY" --docker-email=you@example.com

# ── Tyk OSS gateway ────────────────────────────────────────────────────────
# Admin APISecret for the Tyk REST API. Same value for both vars.
# (Live secret: `secrets-tyk-oss-tyk-gateway`, key `APISecret`, ns `tyk`.)
TYK_SECRET=change-me-strong-secret
TYK_API_SECRET=change-me-strong-secret

# ── Cluster ────────────────────────────────────────────────────────────────
# Control-plane node IP — used by deploy.sh / SSH one-liners.
# Cluster-specific: the worked-example values for the 230/232 clusters are kept
# in the local working dir, not committed here.
HEAD=<control-plane-node-IP>
