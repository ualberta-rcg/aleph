# Copy to .env and fill in real values. .env is gitignored.
# Load into a shell with:  set -a; source .env; set +a

# HuggingFace token used by model init/download containers.
# Used to create the `hf-token` Secret in the `models` namespace (see CLAUDE.md).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tyk OSS gateway APISecret (admin API). Same value for both vars.
TYK_SECRET=change-me-strong-secret
TYK_API_SECRET=change-me-strong-secret

# Cluster head (control-plane) node — used by deploy.sh / SSH one-liners.
HEAD=172.26.92.230
