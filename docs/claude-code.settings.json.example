{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_TYK_KEY",
    "ANTHROPIC_BASE_URL": "https://inference.vulcan.alliancecan.ca/anthropic",
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen35-122b",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-oss-120b",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-oss-20b",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gemma-4-26b-a4b"
  },
  "model": "opus",
  "fallbackModel": ["gpt-oss-120b", "gpt-oss-20b", "gemma-4-26b-a4b"]
}
