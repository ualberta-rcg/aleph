# Aleph site values — shell variable form.
# Copy this file, fill in the values, then use it to substitute tokens before baking
# the Warewulf overlay. See ww-overlays/SITE-VALUES.md for full documentation.
#
# Quick substitute (example using sed):
#   set -a; source site.env; set +a
#   for f in ww-overlays/overlay/etc/rancher/manifests/*.yaml \
#             ww-overlays/overlay/etc/netplan/*.yaml \
#             ww-overlays/overlay/etc/sysctl.d/*.conf; do
#     sed -i \
#       -e "s|__K8S_VERSION__|$K8S_VERSION|g" \
#       -e "s|__NFS_SERVER__|$NFS_SERVER|g" \
#       -e "s|__NFS_PATH__|$NFS_PATH|g" \
#       -e "s|__VIP__|$VIP|g" \
#       -e "s|__PUBLIC_NIC__|$PUBLIC_NIC|g" \
#       -e "s|__PUBLIC_SUBNET__|$PUBLIC_SUBNET|g" \
#       -e "s|__PUBLIC_GW__|$PUBLIC_GW|g" \
#       -e "s|__ACME_EMAIL__|$ACME_EMAIL|g" \
#       -e "s|__TYK_API_SECRET__|$TYK_API_SECRET|g" \
#       "$f"
#   done

# --- Kubernetes / HAMi ---
K8S_VERSION=v1.36.1           # Must match cluster k8s version exactly

# --- NFS storage ---
NFS_SERVER=manage.storage.data.vulcan.local
NFS_PATH=/aleph

# --- Public VIP (MetalLB L2) ---
VIP=129.128.190.55            # The IP MetalLB will own
PUBLIC_NIC=enp6s19            # Head node's public NIC (ip link to confirm)
PUBLIC_SUBNET=129.128.190.48/28
PUBLIC_GW=129.128.190.49      # Only needed for Internet-reachable heads (see netplan comment)

# --- TLS ---
ACME_EMAIL=admin@alliancecan.ca

# --- Tyk admin secret (load from .env, never commit real value) ---
# TYK_API_SECRET=             # set from .env: set -a; source .env; set +a
