# Aleph site values — shell variable form (TEMPLATE — fill in, do not commit real values).
# Copy this file to site.env, fill in the values, then use it to substitute tokens before
# baking the overlays. See ww-overlays/SITE-VALUES.md for full documentation.
#
# Quick substitute (example using sed) — only the control-plane overlay carries tokens:
#   set -a; source site.env; set +a
#   CP=ww-overlays/overlays/control-plane
#   for f in $CP/etc/rancher/manifests/*.yaml \
#            $CP/etc/netplan/*.yaml \
#            $CP/etc/sysctl.d/*.conf; do
#     sed -i \
#       -e "s|__K8S_VERSION__|$K8S_VERSION|g" \
#       -e "s|__NFS_SERVER__|$NFS_SERVER|g" \
#       -e "s|__NFS_PATH__|$NFS_PATH|g" \
#       -e "s|__VIP__|$VIP|g" \
#       -e "s|__PUBLIC_NIC__|$PUBLIC_NIC|g" \
#       -e "s|__PUBLIC_NIC_IP__|$PUBLIC_NIC_IP|g" \
#       -e "s|__PUBLIC_PREFIX__|$PUBLIC_PREFIX|g" \
#       -e "s|__PUBLIC_GW__|$PUBLIC_GW|g" \
#
#   NOTE: __PUBLIC_NIC_IP__ is PER control-plane node. Run the netplan substitution once per head
#   with PUBLIC_NIC_IP set to that head's value, e.g.:
#     PUBLIC_NIC_IP=$HEAD1_PUBLIC_IP sed -i "s|__PUBLIC_NIC_IP__|$PUBLIC_NIC_IP|g" .../60-public-vip.yaml
#       -e "s|__ACME_EMAIL__|$ACME_EMAIL|g" \
#       -e "s|__TYK_API_SECRET__|$TYK_API_SECRET|g" \
#       -e "s|__ROCE_IFNAME__|$ROCE_IFNAME|g" \
#       "$f"
#   done

# --- Kubernetes / HAMi ---
K8S_VERSION=               # e.g. v1.36.1 — must match cluster k8s version exactly

# --- NFS storage ---
NFS_SERVER=               # NFS server hostname or IP for model-weight storage
NFS_PATH=                 # NFS export path (provisioner creates per-PVC subdirs)

# --- Public VIP (MetalLB L2) ---
VIP=                      # the FLOATING VIP MetalLB owns (not pinned to a node), e.g. a.b.c.56
PUBLIC_NIC=               # control-plane public NIC, same name on every head (ip link to confirm)
PUBLIC_PREFIX=            # public subnet prefix length, e.g. 28
PUBLIC_GW=                # public gateway — the PREFERRED default route (metric 50) on each head

# Per-control-plane-node public IP (each head's OWN IP on PUBLIC_NIC, in the VIP's /28, distinct
# from the VIP and from each other). The netplan token __PUBLIC_NIC_IP__ is filled per node from
# these. Only enough heads as you have spare public IPs need numbering (the VIP still floats).
HEAD1_PUBLIC_IP=          # e.g. a.b.c.55
HEAD2_PUBLIC_IP=          # e.g. a.b.c.57
HEAD3_PUBLIC_IP=          # e.g. a.b.c.58
PUBLIC_NIC_IP=            # set to the current head's HEADn_PUBLIC_IP when substituting netplan

# --- RoCE / NCCL ---
ROCE_IFNAME=eth0          # GPU worker's active RoCE NIC (see ww-overlays/NCCL-ROCE.md)

# --- TLS ---
ACME_EMAIL=               # ops email for Let's Encrypt registration

# --- Tyk admin secret (load from .env, never commit real value) ---
# TYK_API_SECRET=         # set from .env: set -a; source .env; set +a
