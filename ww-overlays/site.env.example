# Aleph site values — shell variable form.
# Copy to site.env, replace the DUMMY values with your site's real ones, then substitute
# tokens into the control-plane overlay before baking. NEVER commit a filled site.env.
# Full documentation: docs/SITE-VALUES.md
#
# Quick substitute (example using sed) — only the control-plane overlay carries tokens:
#   set -a; source site.env; set +a
#   CP=ww-overlays/overlays/control-plane
#   for f in $CP/etc/rancher/manifests/*.yaml \
#            $CP/etc/netplan/*.yaml \
#            $CP/etc/sysctl.d/*.conf; do
#     sed -i \
#       -e "s|__K8S_VERSION__|$K8S_VERSION|g" \
#       -e "s|__NFS_SERVER__|$NFS_SERVER|g" \
#       -e "s|__NFS_PATH__|$NFS_PATH|g" \
#       -e "s|__VIP__|$VIP|g" \
#       -e "s|__PUBLIC_NIC__|$PUBLIC_NIC|g" \
#       -e "s|__PUBLIC_PREFIX__|$PUBLIC_PREFIX|g" \
#       -e "s|__PUBLIC_GW__|$PUBLIC_GW|g" \
#       -e "s|__ACME_EMAIL__|$ACME_EMAIL|g" \
#       -e "s|__TYK_API_SECRET__|$TYK_API_SECRET|g" \
#       -e "s|__ROCE_IFNAME__|$ROCE_IFNAME|g" \
#       -e "s|__INFERENCE_HOST__|$INFERENCE_HOST|g" \
#       "$f"
#   done
#
#   NOTE: __PUBLIC_NIC_IP__ is PER control-plane node. Run the netplan substitution once per
#   head with PUBLIC_NIC_IP set to that head's value, e.g.:
#     PUBLIC_NIC_IP=$HEAD1_PUBLIC_IP sed -i "s|__PUBLIC_NIC_IP__|$PUBLIC_NIC_IP|g" .../60-public-vip.yaml
#
# The values below are DUMMIES (RFC 5737 documentation ranges / example domains) so the file
# doubles as a working template for a test bake.

# --- Kubernetes / HAMi ---
K8S_VERSION=v1.36.1              # must match the cluster's Kubernetes version EXACTLY
                                 # (HAMi ships a patched kube-scheduler pinned to it)

# --- NFS storage ---
NFS_SERVER=nfs.example.internal  # NFS server hostname/IP for model-weight storage
NFS_PATH=/exports/aleph          # NFS export root (provisioner creates per-PVC subdirs under it)

# --- Public edge ---
INFERENCE_HOST=inference.example.ca  # public hostname (DNS → VIP; Traefik routes + LE cert CN)
VIP=192.0.2.56                   # the FLOATING VIP MetalLB owns (not pinned to a node)
PUBLIC_NIC=enp6s0                # control-plane public NIC, same name on every head (ip link)
PUBLIC_PREFIX=28                 # public subnet prefix length
PUBLIC_GW=192.0.2.54             # public gateway — the PREFERRED default route (metric 50) on each head

# Per-control-plane-node public IP (each head's OWN IP on PUBLIC_NIC, in the VIP's prefix,
# distinct from the VIP and from each other). The netplan token __PUBLIC_NIC_IP__ is filled
# per node from these. Only enough heads as you have spare public IPs need numbering (the
# VIP still floats).
HEAD1_PUBLIC_IP=192.0.2.57
HEAD2_PUBLIC_IP=192.0.2.58
HEAD3_PUBLIC_IP=192.0.2.59
PUBLIC_NIC_IP=                   # set to the current head's HEADn_PUBLIC_IP when substituting netplan

# --- RoCE / NCCL ---
ROCE_IFNAME=eth0                 # GPU worker's active RoCE NIC (see docs/NCCL-ROCE.md)

# --- TLS ---
ACME_EMAIL=ops@example.ca        # ops email for Let's Encrypt registration

# --- Tyk admin secret (load from .env, never commit real value) ---
# TYK_API_SECRET=                # set from .env: set -a; source .env; set +a
