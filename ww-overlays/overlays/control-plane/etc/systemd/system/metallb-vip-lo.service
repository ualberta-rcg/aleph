# MetalLB public VIP on loopback — control-plane overlay.
#
# APPLIES TO: HEAD/edge nodes ONLY (the nodes that advertise the VIP). Not GPU workers.
# TARGET PATH on node: /etc/systemd/system/metallb-vip-lo.service
# SITE VALUES: __VIP__  (see ww-overlays/SITE-VALUES.md)
#
# WHY: the VIP must exist as a LOCAL address so the node's replies to public clients
# source from __VIP__ (not from the NIC's own IP). This is the proven `.55`-on-`lo`
# recipe. We use a systemd oneshot (not netplan) because netplan cannot address `lo`
# and the `dummy:`/`dummy-devices:` key is rejected on this netplan build — see
# etc/netplan/60-public-vip.yaml (which now only does the NIC IP-free + on-link route).
#
# Enabled via the symlink in multi-user.target.wants/ alongside this file.
# Idempotent: ExecStart is prefixed with `-` so a re-add of an existing address is
# ignored rather than failing the unit.
[Unit]
Description=Bind MetalLB public VIP (__VIP__) to lo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/sbin/ip address add __VIP__/32 dev lo
ExecStop=-/usr/sbin/ip address del __VIP__/32 dev lo

[Install]
WantedBy=multi-user.target
